# Model Providers
OPENAI_API_KEY=your_openai_api_key_here
BLOG_AGENT_MODEL=gpt-4.1-mini

# Web Search (Tavily)
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: LangSmith Observability & Tracing
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=blog-writing-agent

# Optional: PostgreSQL Database URI for Checkpointing (defaults to in-memory if unavailable)
BLOG_AGENT_DB_URI=postgresql://postgres:postgres@localhost:5442/postgres
